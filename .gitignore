.gitignore
# Python
__pycache__/
*.py[cod]
*.pyd
*.so

# Virtual environments
.venv/
venv/
.uv-cache/

# Testing and tooling
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# IDEs
.vscode/
.idea/

# Operating system
.DS_Store
Thumbs.db

# Fresh simulation sweeps (regenerated by the Julia runners). The bundled
# reproduction inputs under data/{baseline,influencer,baseline_svd,influencer_svd}
# are tracked.
data/sweep_*/
*.arrow
!data/baseline/simulations.arrow
!data/influencer/simulations.arrow

# CSVs are regenerated outputs unless explicitly bundled
*.csv
!sobol/design.csv
!analysis/runs/mser_probe/mser_probe_cascades.csv

# Accumulator caches: only the bundled reproduction inputs are tracked
*.npz
!analysis/runs/nodecache/*.npz
!analysis/runs/svdecomp/acc_baseline.npz
!analysis/runs/svdecomp/acc_influencer.npz
!analysis/runs/switchover_audit/acc_switchover_baseline.npz
!analysis/runs/switchover_audit/acc_switchover_influencer.npz

# Regenerated analysis outputs (reproduce_analysis.sh rebuilds these)
figures/
results/
outputs/
analysis/runs/**/*_evidence.json
!analysis/runs/tost_clustered/tost_evidence.json
!analysis/runs/tost_profile/profile_evidence.json
analysis/runs/**/*.png
analysis/runs/tost_blocks/
analysis/runs/loss_edge/
analysis/runs/mean_field/
analysis/runs/replication_justification/

# Misc
*.zip
*.log
slurm-*.out
reproduction_jasss_07_06/
snellius_logs/
